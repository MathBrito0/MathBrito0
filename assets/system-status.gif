from PIL import Image, ImageDraw, ImageFont

frames = []

font = ImageFont.truetype("DejaVuSansMono.ttf", 28)

for i in range(21):
    img = Image.new("RGB", (700, 100), "#0D1117")
    draw = ImageDraw.Draw(img)

    bar = "█" * i + "░" * (20 - i)

    draw.text(
        (30, 30),
        f"[{bar}]",
        font=font,
        fill="#00BFFF"
    )

    frames.append(img)

frames[0].save(
    "assets/system-status.gif",
    save_all=True,
    append_images=frames[1:],
    duration=100,
    loop=0
)
